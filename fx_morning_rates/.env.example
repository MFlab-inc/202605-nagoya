# ===========================================================================
#  設定ファイルのサンプルです。
#  このファイルをコピーして「.env」という名前で保存し、中身を自分の値に直してください。
#  （= の右側だけ書き換えればOK。ファイル名は必ず ".env" にしてください）
# ===========================================================================

# 【共通】Google スプレッドシートのID（URLの長い部分）
GOOGLE_SHEETS_ID=1P3kDrOwb5wQxNd34NBQe-IoNr76BN2x7USOPQC7saKw

# 【共通】合鍵JSONファイルの場所（フルパス）
#   Mac の例:     /Users/あなたの名前/fx-rates/service-account.json
#   Windows の例: C:\Users\あなたの名前\fx-rates\service-account.json
GOOGLE_APPLICATION_CREDENTIALS=ここに合鍵JSONのフルパスを書く

# 【朝用(金利)だけ必要】FRED の APIキー。夕方用(FX)だけ使うなら空のままでOK
FRED_API_KEY=

# --- 以下は通常そのままでOK（必要なときだけ変更） ---------------------------
# 夕方FXの書き込み先タブ名
GOOGLE_SHEETS_WORKSHEET_FX=fx_evening
# 朝・金利の書き込み先タブ名
GOOGLE_SHEETS_WORKSHEET=fred_daily
# データが何時間より古いと「stale(古い)」とみなすか
FX_STALE_AFTER_HOURS=12
